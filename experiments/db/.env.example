# Copy this to experiments/db/.env (which is gitignored) and fill in the
# real password. NEVER commit the real .env.
#
# These values target the decision-maker Postgres via a kubectl port-forward
# session opened by experiments/db/port-forward.ps1.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobmetricsdb
DB_USER=pguser
DB_PASSWORD=CHANGE_ME

# Port-forward target (used by experiments/db/port-forward.ps1 since iter-4a).
# These point at the Karmada-hosted Postgres service on on-prem.
PG_K8S_CONTEXT=on-prem
PG_K8S_NAMESPACE=karmada-system
PG_K8S_SERVICE=postgres
PG_K8S_PORT=5432
PG_LOCAL_PORT=5432
