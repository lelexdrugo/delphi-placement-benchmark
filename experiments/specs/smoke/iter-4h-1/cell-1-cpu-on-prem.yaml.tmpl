apiVersion: batch/v1
kind: Job
metadata:
  name: iter-4h-1-smoke-cell-1-cpu-on-prem
  namespace: delphi-experiments
  annotations:
    optimize-propagation: "true"
    propagation-requirements: '{"latency":"medium","cost":"medium","region":"on-premises","weight":1.0}'
    delphi.experiments/pin-to-cluster: "on-prem"
    delphi.experiments/spec-id: "iter-4h-1-smoke"
    delphi.experiments/run-id: "${RUN_ID}"
    delphi.experiments/intent-profile: "balanced"
    delphi.experiments/workload-class: "cpu"
  labels:
    delphi.experiments/spec-id: "iter-4h-1-smoke"
    delphi.experiments/run-id: "${RUN_ID}"
    delphi.experiments/role: "foreground"
    delphi.experiments/intent-profile: "balanced"
    delphi.experiments/workload-class: "cpu"
    delphi.experiments/cell: "cell-1-cpu-on-prem"
spec:
  backoffLimit: 1
  template:
    metadata:
      labels:
        delphi.experiments/spec-id: "iter-4h-1-smoke"
        delphi.experiments/run-id: "${RUN_ID}"
        delphi.experiments/role: "foreground"
        delphi.experiments/intent-profile: "balanced"
        delphi.experiments/workload-class: "cpu"
        delphi.experiments/cell: "cell-1-cpu-on-prem"
    spec:
      restartPolicy: Never
      containers:
        - name: stress-ng-runner
          image: ${SMOKE_IMAGE_STRESS_NG}
          env:
            - name: BENCHMARK_TYPE
              value: "iter-4h-1-smoke/cpu/cell-1"
            - name: TASK_TYPE
              value: "cpu"
            - name: WORK_MODE
              value: "ops"
            - name: CPU_LOAD
              value: "2"
            - name: CPU_OPS
              value: "65000"
          resources:
            requests: { cpu: "500m",  memory: "128Mi" }
            limits:   { cpu: "1000m", memory: "256Mi" }
