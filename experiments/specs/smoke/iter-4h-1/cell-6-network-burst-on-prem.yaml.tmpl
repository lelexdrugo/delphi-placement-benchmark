apiVersion: batch/v1
kind: Job
metadata:
  name: iter-4h-1-smoke-cell-6-network-burst-on-prem
  namespace: delphi-experiments
  annotations:
    optimize-propagation: "true"
    propagation-requirements: '{"latency":"medium","cost":"medium","region":"on-premises","weight":1.0}'
    delphi.experiments/pin-to-cluster: "on-prem"
    delphi.experiments/spec-id: "iter-4h-1-smoke"
    delphi.experiments/run-id: "${RUN_ID}"
    delphi.experiments/intent-profile: "balanced"
    delphi.experiments/workload-class: "network"
  labels:
    delphi.experiments/spec-id: "iter-4h-1-smoke"
    delphi.experiments/run-id: "${RUN_ID}"
    delphi.experiments/role: "foreground"
    delphi.experiments/intent-profile: "balanced"
    delphi.experiments/workload-class: "network"
    delphi.experiments/cell: "cell-6-network-burst-on-prem"
spec:
  backoffLimit: 1
  template:
    metadata:
      labels:
        delphi.experiments/spec-id: "iter-4h-1-smoke"
        delphi.experiments/run-id: "${RUN_ID}"
        delphi.experiments/role: "foreground"
        delphi.experiments/intent-profile: "balanced"
        delphi.experiments/workload-class: "network"
        delphi.experiments/cell: "cell-6-network-burst-on-prem"
    spec:
      restartPolicy: Never
      containers:
        - name: net-stresser
          image: ${SMOKE_IMAGE_NET_STRESSER}
          env:
            - name: MODE
              value: "burst-download"
            - name: TARGET_HOST
              value: "203.0.113.10"
            - name: TARGET_PORT
              value: "31521"
            - name: BURST_SIZE
              value: "200M"
            # DURATION accepted but unused by burst-download after
            # iter-4h-1's de-clip (iperf3 -n is the completion signal).
            - name: DURATION
              value: "60s"
          resources:
            requests: { cpu: "200m", memory: "128Mi" }
            limits:   { cpu: "500m", memory: "256Mi" }
